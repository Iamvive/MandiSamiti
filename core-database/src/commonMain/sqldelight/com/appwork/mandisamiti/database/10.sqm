CREATE TABLE IF NOT EXISTS shopQuotaEntity (
    shop_id TEXT PRIMARY KEY NOT NULL,
    plan_tier TEXT NOT NULL DEFAULT 'FREE',
    monthly_limit INTEGER NOT NULL DEFAULT 50,
    emergency_extensions_used INTEGER NOT NULL DEFAULT 0,
    emergency_bills_added INTEGER NOT NULL DEFAULT 0,
    bills_created_this_month INTEGER NOT NULL DEFAULT 0,
    last_synced_at INTEGER NOT NULL DEFAULT 0
);
