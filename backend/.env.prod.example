# MandiSamiti Backend Production Environment
# Copy to .env.prod on the VPS; never commit this file to version control
# Replace all placeholder values with actual secrets from your deployment

PROJECT_NAME="MandiSamiti Backend API"
VERSION="1.0.0"

# Database Configuration
POSTGRES_USER=change-me-prod-user
POSTGRES_PASSWORD=change-me-64-character-secure-password
POSTGRES_DB=mandisamiti_prod
DATABASE_URL=postgresql+asyncpg://change-me-prod-user:change-me-64-character-secure-password@db:5432/mandisamiti_prod

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# API Security
SECRET_KEY=change-me-64-hex-character-secret-key-for-jwt

# OTP Configuration
OTP_STATIC_ENABLED=true
OTP_STATIC_CODE=123456
