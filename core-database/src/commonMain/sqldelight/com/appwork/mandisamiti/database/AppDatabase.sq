-- Shop Profile / Multi-Tenancy
CREATE TABLE shopProfileEntity (
    id TEXT PRIMARY KEY NOT NULL,
    shop_name TEXT NOT NULL,
    owner_name TEXT NOT NULL,
    mandi_name TEXT NOT NULL,
    shop_number TEXT,
    phone_number TEXT NOT NULL,
    pin_hash TEXT NOT NULL,
    default_monthly_interest_rate REAL NOT NULL DEFAULT 1.5,
    is_sound_enabled INTEGER NOT NULL DEFAULT 1,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    sync_status INTEGER NOT NULL DEFAULT 0
);

-- Party Master (Farmers & Buyers)
CREATE TABLE partyEntity (
    id TEXT PRIMARY KEY NOT NULL,
    shop_id TEXT NOT NULL,
    name TEXT NOT NULL,
    phone TEXT,
    village TEXT,
    party_type TEXT NOT NULL, -- 'FARMER' | 'BUYER'
    monthly_interest_rate REAL,
    photo_uri TEXT,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    is_deleted INTEGER NOT NULL DEFAULT 0,
    sync_status INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY(shop_id) REFERENCES shopProfileEntity(id)
);

CREATE INDEX idx_party_shop ON partyEntity(shop_id, is_deleted);
CREATE INDEX idx_party_name ON partyEntity(name);

-- Commodity Master
CREATE TABLE commodityEntity (
    id TEXT PRIMARY KEY NOT NULL,
    shop_id TEXT NOT NULL,
    name_hi TEXT NOT NULL,
    name_en TEXT NOT NULL,
    default_unit TEXT NOT NULL DEFAULT 'QUINTAL',
    is_active INTEGER NOT NULL DEFAULT 1,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    is_deleted INTEGER NOT NULL DEFAULT 0,
    sync_status INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY(shop_id) REFERENCES shopProfileEntity(id)
);

-- Deal / Crop Sale (Two-Stage Settlement with Full Editability)
CREATE TABLE dealEntity (
    id TEXT PRIMARY KEY NOT NULL,
    shop_id TEXT NOT NULL,
    farmer_id TEXT NOT NULL,
    buyer_id TEXT,
    commodity_id TEXT NOT NULL,
    deal_status TEXT NOT NULL, -- 'PENDING_SETTLEMENT' | 'SETTLED' | 'CANCELLED'
    deal_date INTEGER NOT NULL,

    -- Weight details (Grams)
    bags_count INTEGER NOT NULL,
    gross_weight_grams INTEGER NOT NULL,
    cut_weight_grams INTEGER NOT NULL DEFAULT 0,
    net_weight_grams INTEGER NOT NULL,

    -- Pricing details (Paisa)
    rate_paisa_per_unit INTEGER,
    gross_amount_paisa INTEGER NOT NULL DEFAULT 0,

    -- Manual Deductions (Paisa)
    farmer_commission_paisa INTEGER NOT NULL DEFAULT 0,
    buyer_commission_paisa INTEGER NOT NULL DEFAULT 0,
    labour_charge_paisa INTEGER NOT NULL DEFAULT 0,
    weighing_charge_paisa INTEGER NOT NULL DEFAULT 0,
    other_deductions_paisa INTEGER NOT NULL DEFAULT 0,

    -- Final Settlements (Paisa)
    net_farmer_payable_paisa INTEGER NOT NULL DEFAULT 0,
    net_buyer_receivable_paisa INTEGER NOT NULL DEFAULT 0,

    receipt_photo_uri TEXT,
    voice_note_uri TEXT,
    remarks TEXT,

    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    is_deleted INTEGER NOT NULL DEFAULT 0,
    sync_status INTEGER NOT NULL DEFAULT 0,
    farmer_commission_bps INTEGER NOT NULL DEFAULT 0,
    revision INTEGER NOT NULL DEFAULT 1,
    is_void INTEGER NOT NULL DEFAULT 0,
    void_reason TEXT,
    FOREIGN KEY(farmer_id) REFERENCES partyEntity(id),
    FOREIGN KEY(buyer_id) REFERENCES partyEntity(id),
    FOREIGN KEY(commodity_id) REFERENCES commodityEntity(id)
);

CREATE INDEX idx_deal_farmer ON dealEntity(farmer_id, is_deleted);
CREATE INDEX idx_deal_buyer ON dealEntity(buyer_id, is_deleted);
CREATE INDEX idx_deal_date ON dealEntity(deal_date);

-- Direct Cash, Interest & Discount Transactions (उधार / जमा / ब्याज / छूट)
CREATE TABLE cashTransactionEntity (
    id TEXT PRIMARY KEY NOT NULL,
    shop_id TEXT NOT NULL,
    party_id TEXT NOT NULL,
    deal_id TEXT,
    transaction_type TEXT NOT NULL, -- 'UDHAR_GIVEN', 'JAMA_RECEIVED', 'INTEREST_ADDED', 'DISCOUNT_GIVEN'
    amount_paisa INTEGER NOT NULL,
    payment_mode TEXT NOT NULL DEFAULT 'CASH',
    transaction_date INTEGER NOT NULL,
    voice_note_uri TEXT,
    remarks TEXT,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    is_deleted INTEGER NOT NULL DEFAULT 0,
    sync_status INTEGER NOT NULL DEFAULT 0,
    revision INTEGER NOT NULL DEFAULT 1,
    is_void INTEGER NOT NULL DEFAULT 0,
    void_reason TEXT,
    FOREIGN KEY(party_id) REFERENCES partyEntity(id),
    FOREIGN KEY(deal_id) REFERENCES dealEntity(id)
);

CREATE INDEX idx_tx_party ON cashTransactionEntity(party_id, is_deleted);
CREATE INDEX idx_tx_date ON cashTransactionEntity(transaction_date);

-- Append-only audit trail: one row per create / edit / void of a deal or cash entry
CREATE TABLE entryRevisionEntity (
    id TEXT PRIMARY KEY NOT NULL,
    shop_id TEXT NOT NULL,
    entry_id TEXT NOT NULL,
    entry_kind TEXT NOT NULL, -- 'DEAL' | 'CASH'
    revision INTEGER NOT NULL,
    change_kind TEXT NOT NULL, -- 'CREATE' | 'EDIT' | 'VOID'
    snapshot_json TEXT NOT NULL,
    void_reason TEXT,
    changed_at INTEGER NOT NULL,
    sync_status INTEGER NOT NULL DEFAULT 0,
    UNIQUE(entry_id, revision)
);
CREATE INDEX idx_revision_entry ON entryRevisionEntity(entry_id, revision);

CREATE TABLE buyEntryEntity (
    id TEXT PRIMARY KEY NOT NULL,
    shop_id TEXT NOT NULL,
    farmer_id TEXT NOT NULL,
    commodity_id TEXT NOT NULL,
    entry_date INTEGER NOT NULL,
    bags_count INTEGER NOT NULL,
    weight_per_bag_grams INTEGER NOT NULL,
    extra_weight_grams INTEGER NOT NULL DEFAULT 0,
    total_weight_grams INTEGER NOT NULL,
    rate_paisa_per_quintal INTEGER NOT NULL,
    commission_bps INTEGER NOT NULL DEFAULT 0,
    labour_per_bag_paisa INTEGER NOT NULL DEFAULT 0,
    advance_paid_paisa INTEGER NOT NULL DEFAULT 0,
    gross_paisa INTEGER NOT NULL,
    commission_paisa INTEGER NOT NULL,
    labour_paisa INTEGER NOT NULL,
    net_payable_paisa INTEGER NOT NULL,
    paid_paisa INTEGER NOT NULL DEFAULT 0,
    vehicle_number TEXT,
    slip_number TEXT,
    remarks TEXT,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    is_deleted INTEGER NOT NULL DEFAULT 0,
    sync_status INTEGER NOT NULL DEFAULT 0,
    revision INTEGER NOT NULL DEFAULT 1,
    is_void INTEGER NOT NULL DEFAULT 0,
    void_reason TEXT,
    FOREIGN KEY(farmer_id) REFERENCES partyEntity(id),
    FOREIGN KEY(commodity_id) REFERENCES commodityEntity(id)
);
CREATE INDEX idx_buy_shop_date ON buyEntryEntity(shop_id, entry_date);
CREATE INDEX idx_buy_farmer ON buyEntryEntity(farmer_id);

CREATE TABLE sellEntryEntity (
    id TEXT PRIMARY KEY NOT NULL,
    shop_id TEXT NOT NULL,
    buyer_id TEXT NOT NULL,
    commodity_id TEXT NOT NULL,
    entry_date INTEGER NOT NULL,
    bill_mode TEXT NOT NULL,          -- 'NORMAL' | 'BILL_OF_SUPPLY'
    party_kind TEXT NOT NULL,         -- 'MERCHANT' | 'CUSTOMER'
    gstin TEXT,
    bags_count INTEGER NOT NULL,
    weight_per_bag_grams INTEGER NOT NULL,
    total_weight_grams INTEGER NOT NULL,
    rate_paisa_per_quintal INTEGER NOT NULL,
    arat_bps INTEGER NOT NULL DEFAULT 0,
    tulak_paisa INTEGER NOT NULL DEFAULT 0,
    gross_paisa INTEGER NOT NULL,
    arat_paisa INTEGER NOT NULL,
    mandi_shulk_paisa INTEGER NOT NULL,
    total_receivable_paisa INTEGER NOT NULL,
    received_paisa INTEGER NOT NULL DEFAULT 0,
    balance_due_paisa INTEGER NOT NULL,
    vehicle_number TEXT,
    invoice_number TEXT,
    remarks TEXT,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    is_deleted INTEGER NOT NULL DEFAULT 0,
    sync_status INTEGER NOT NULL DEFAULT 0,
    revision INTEGER NOT NULL DEFAULT 1,
    is_void INTEGER NOT NULL DEFAULT 0,
    void_reason TEXT,
    FOREIGN KEY(buyer_id) REFERENCES partyEntity(id),
    FOREIGN KEY(commodity_id) REFERENCES commodityEntity(id)
);
CREATE INDEX idx_sell_shop_date ON sellEntryEntity(shop_id, entry_date);
CREATE INDEX idx_sell_buyer ON sellEntryEntity(buyer_id);

CREATE TABLE lendEntryEntity (
    id TEXT PRIMARY KEY NOT NULL,
    shop_id TEXT NOT NULL,
    party_id TEXT NOT NULL,
    lend_type TEXT NOT NULL,          -- 'MONEY' | 'GRAIN'
    entry_date INTEGER NOT NULL,
    amount_paisa INTEGER NOT NULL DEFAULT 0,
    commodity_id TEXT,
    bags_count INTEGER NOT NULL DEFAULT 0,
    weight_grams INTEGER NOT NULL DEFAULT 0,
    expected_return_date INTEGER,
    notes TEXT,
    status TEXT NOT NULL DEFAULT 'OPEN', -- 'OPEN' | 'PARTIAL' | 'SETTLED'
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    is_deleted INTEGER NOT NULL DEFAULT 0,
    sync_status INTEGER NOT NULL DEFAULT 0,
    revision INTEGER NOT NULL DEFAULT 1,
    is_void INTEGER NOT NULL DEFAULT 0,
    void_reason TEXT,
    FOREIGN KEY(party_id) REFERENCES partyEntity(id)
);
CREATE INDEX idx_lend_shop_status ON lendEntryEntity(shop_id, status);

CREATE TABLE lendSettlementEntity (
    id TEXT PRIMARY KEY NOT NULL,
    shop_id TEXT NOT NULL,
    lend_id TEXT NOT NULL,
    settled_at INTEGER NOT NULL,
    amount_paisa INTEGER NOT NULL DEFAULT 0,
    weight_grams INTEGER NOT NULL DEFAULT 0,
    bags_count INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    sync_status INTEGER NOT NULL DEFAULT 0,
    revision INTEGER NOT NULL DEFAULT 1,
    is_void INTEGER NOT NULL DEFAULT 0,
    void_reason TEXT,
    FOREIGN KEY(lend_id) REFERENCES lendEntryEntity(id)
);
CREATE INDEX idx_settle_lend ON lendSettlementEntity(lend_id);

CREATE TABLE expenseEntryEntity (
    id TEXT PRIMARY KEY NOT NULL,
    shop_id TEXT NOT NULL,
    entry_date INTEGER NOT NULL,
    category TEXT NOT NULL,           -- 'HAMMALI' | 'KIRAYA' | 'BIJLI' | 'CHAI_PANI' | 'MAJDOORI' | 'OTHER'
    amount_paisa INTEGER NOT NULL,
    paid_to TEXT,
    payment_mode TEXT NOT NULL DEFAULT 'CASH', -- 'CASH' | 'ONLINE' | 'CHEQUE'
    remarks TEXT,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    is_deleted INTEGER NOT NULL DEFAULT 0,
    sync_status INTEGER NOT NULL DEFAULT 0,
    revision INTEGER NOT NULL DEFAULT 1,
    is_void INTEGER NOT NULL DEFAULT 0,
    void_reason TEXT
);
CREATE INDEX idx_expense_shop_date ON expenseEntryEntity(shop_id, entry_date);

-- ================= QUERIES =================

-- Shop Profile Queries
getShopProfile:
SELECT * FROM shopProfileEntity LIMIT 1;

insertShopProfile:
INSERT OR REPLACE INTO shopProfileEntity(id, shop_name, owner_name, mandi_name, shop_number, phone_number, pin_hash, default_monthly_interest_rate, is_sound_enabled, created_at, updated_at, sync_status)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateSoundSetting:
UPDATE shopProfileEntity SET is_sound_enabled = ?, updated_at = ? WHERE id = ?;

-- Party Queries
getAllParties:
SELECT * FROM partyEntity WHERE shop_id = ? AND is_deleted = 0 ORDER BY name ASC;

getPartyById:
SELECT * FROM partyEntity WHERE id = ? AND is_deleted = 0;

insertParty:
INSERT OR REPLACE INTO partyEntity(id, shop_id, name, phone, village, party_type, monthly_interest_rate, photo_uri, created_at, updated_at, is_deleted, sync_status)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

softDeleteParty:
UPDATE partyEntity SET is_deleted = 1, updated_at = ?, sync_status = 0 WHERE id = ?;

-- Commodity Queries
getAllCommodities:
SELECT * FROM commodityEntity WHERE shop_id = ? AND is_deleted = 0 ORDER BY name_hi ASC;

insertCommodity:
INSERT OR REPLACE INTO commodityEntity(id, shop_id, name_hi, name_en, default_unit, is_active, created_at, updated_at, is_deleted, sync_status)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Deal Queries
getDealsByShop:
SELECT * FROM dealEntity WHERE shop_id = ? AND is_deleted = 0 ORDER BY deal_date DESC;

getDealsByFarmer:
SELECT * FROM dealEntity WHERE farmer_id = ? AND is_deleted = 0 ORDER BY deal_date DESC;

getDealsByBuyer:
SELECT * FROM dealEntity WHERE buyer_id = ? AND is_deleted = 0 ORDER BY deal_date DESC;

getDealById:
SELECT * FROM dealEntity WHERE id = ?;

getPendingDeals:
SELECT * FROM dealEntity WHERE shop_id = ? AND deal_status = 'PENDING_SETTLEMENT' AND is_deleted = 0 ORDER BY deal_date DESC;

insertDeal:
INSERT OR REPLACE INTO dealEntity(
    id, shop_id, farmer_id, buyer_id, commodity_id, deal_status, deal_date,
    bags_count, gross_weight_grams, cut_weight_grams, net_weight_grams,
    rate_paisa_per_unit, gross_amount_paisa,
    farmer_commission_paisa, buyer_commission_paisa, labour_charge_paisa, weighing_charge_paisa, other_deductions_paisa,
    net_farmer_payable_paisa, net_buyer_receivable_paisa,
    receipt_photo_uri, voice_note_uri, remarks,
    created_at, updated_at, is_deleted, sync_status,
    farmer_commission_bps, revision, is_void, void_reason
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Cash Transaction Queries
getCashTransactionsByParty:
SELECT * FROM cashTransactionEntity WHERE party_id = ? AND is_deleted = 0 ORDER BY transaction_date DESC;

getCashTransactionsByShop:
SELECT * FROM cashTransactionEntity WHERE shop_id = ? AND is_deleted = 0 ORDER BY transaction_date DESC;

insertCashTransaction:
INSERT OR REPLACE INTO cashTransactionEntity(id, shop_id, party_id, deal_id, transaction_type, amount_paisa, payment_mode, transaction_date, voice_note_uri, remarks, created_at, updated_at, is_deleted, sync_status, revision, is_void, void_reason)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getCashTransactionById:
SELECT * FROM cashTransactionEntity WHERE id = ?;

-- Party Running Balance Aggregation Query
-- Positive = लेना है (Receivable), Negative = देना है (Payable)
getPartyBalance:
SELECT
    p.id AS party_id,
    p.name AS party_name,
    p.village AS party_village,
    p.party_type AS party_type,
    (
        -- 1. Cash Advances given to party (+)
        COALESCE((SELECT SUM(amount_paisa) FROM cashTransactionEntity WHERE party_id = p.id AND transaction_type = 'UDHAR_GIVEN' AND is_deleted = 0 AND is_void = 0), 0)
        +
        -- 2. Interest added to party (+)
        COALESCE((SELECT SUM(amount_paisa) FROM cashTransactionEntity WHERE party_id = p.id AND transaction_type = 'INTEREST_ADDED' AND is_deleted = 0 AND is_void = 0), 0)
        -
        -- 3. Cash Received from party (-)
        COALESCE((SELECT SUM(amount_paisa) FROM cashTransactionEntity WHERE party_id = p.id AND transaction_type = 'JAMA_RECEIVED' AND is_deleted = 0 AND is_void = 0), 0)
        -
        -- 4. Discounts given to party (-)
        COALESCE((SELECT SUM(amount_paisa) FROM cashTransactionEntity WHERE party_id = p.id AND transaction_type = 'DISCOUNT_GIVEN' AND is_deleted = 0 AND is_void = 0), 0)
        +
        -- 5. Deals where party is BUYER: Buyer owes shop (+)
        COALESCE((SELECT SUM(net_buyer_receivable_paisa) FROM dealEntity WHERE buyer_id = p.id AND deal_status = 'SETTLED' AND is_deleted = 0 AND is_void = 0), 0)
        -
        -- 6. Deals where party is FARMER: Shop owes farmer (-)
        COALESCE((SELECT SUM(net_farmer_payable_paisa) FROM dealEntity WHERE farmer_id = p.id AND deal_status = 'SETTLED' AND is_deleted = 0 AND is_void = 0), 0)
    ) AS balance_paisa
FROM partyEntity p
WHERE p.id = ? AND p.is_deleted = 0;

-- Sync Outbox Queries
getPendingSyncParties:
SELECT * FROM partyEntity WHERE sync_status = 0;

getPendingSyncDeals:
SELECT * FROM dealEntity WHERE sync_status = 0;

getPendingSyncTransactions:
SELECT * FROM cashTransactionEntity WHERE sync_status = 0;

markPartySynced:
UPDATE partyEntity SET sync_status = 1 WHERE id = ?;

markDealSynced:
UPDATE dealEntity SET sync_status = 1 WHERE id = ? AND revision = ?;

markTransactionSynced:
UPDATE cashTransactionEntity SET sync_status = 1 WHERE id = ? AND revision = ?;

-- Applying a server row: replace only a row that has nothing unsynced; a pending local edit wins until pushed.
-- (Default SQLDelight dialect is SQLite 3.18: no UPSERT, so delete-if-synced then insert-if-absent.)
deleteSyncedParty:
DELETE FROM partyEntity WHERE id = ? AND sync_status = 1;

insertPartyIfAbsent:
INSERT OR IGNORE INTO partyEntity(id, shop_id, name, phone, village, party_type, monthly_interest_rate, photo_uri, created_at, updated_at, is_deleted, sync_status)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteSyncedDeal:
DELETE FROM dealEntity WHERE id = ? AND sync_status = 1;

insertDealIfAbsent:
INSERT OR IGNORE INTO dealEntity(
    id, shop_id, farmer_id, buyer_id, commodity_id, deal_status, deal_date,
    bags_count, gross_weight_grams, cut_weight_grams, net_weight_grams,
    rate_paisa_per_unit, gross_amount_paisa,
    farmer_commission_paisa, buyer_commission_paisa, labour_charge_paisa, weighing_charge_paisa, other_deductions_paisa,
    net_farmer_payable_paisa, net_buyer_receivable_paisa,
    receipt_photo_uri, voice_note_uri, remarks,
    created_at, updated_at, is_deleted, sync_status,
    farmer_commission_bps, revision, is_void, void_reason
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteSyncedCashTransaction:
DELETE FROM cashTransactionEntity WHERE id = ? AND sync_status = 1;

insertCashTransactionIfAbsent:
INSERT OR IGNORE INTO cashTransactionEntity(id, shop_id, party_id, deal_id, transaction_type, amount_paisa, payment_mode, transaction_date, voice_note_uri, remarks, created_at, updated_at, is_deleted, sync_status, revision, is_void, void_reason)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- A revision pulled from the server: already synced; ignored if we hold (id) or (entry_id, revision).
insertRevisionFromServer:
INSERT OR IGNORE INTO entryRevisionEntity(id, shop_id, entry_id, entry_kind, revision, change_kind, snapshot_json, void_reason, changed_at, sync_status)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, 1);

-- Ack a pushed party only if it was not edited after the push read it.
markPartySyncedAt:
UPDATE partyEntity SET sync_status = 1 WHERE id = ? AND updated_at = ?;

-- Revision Queries
insertRevision:
INSERT INTO entryRevisionEntity(id, shop_id, entry_id, entry_kind, revision, change_kind, snapshot_json, void_reason, changed_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

getRevisionsForEntry:
SELECT * FROM entryRevisionEntity WHERE entry_id = ? ORDER BY revision ASC;

getPendingSyncRevisions:
SELECT * FROM entryRevisionEntity WHERE sync_status = 0;

markRevisionSynced:
UPDATE entryRevisionEntity SET sync_status = 1 WHERE id = ?;

getPendingSyncCount:
SELECT (
    (SELECT COUNT(*) FROM partyEntity WHERE sync_status = 0) +
    (SELECT COUNT(*) FROM dealEntity WHERE sync_status = 0) +
    (SELECT COUNT(*) FROM cashTransactionEntity WHERE sync_status = 0) +
    (SELECT COUNT(*) FROM entryRevisionEntity WHERE sync_status = 0)
) AS pending_count;


-- User-facing count: distinct unsynced entries (a row and its revision count once); excludes the shop profile
getPendingEntryCount:
SELECT COUNT(*) FROM (
    SELECT id FROM partyEntity WHERE sync_status = 0
    UNION
    SELECT id FROM dealEntity WHERE sync_status = 0
    UNION
    SELECT id FROM cashTransactionEntity WHERE sync_status = 0
    UNION
    SELECT entry_id FROM entryRevisionEntity WHERE sync_status = 0
);

-- Rows (deleted or not) that belong to any shop other than ?
countForeignRows:
SELECT (
    (SELECT COUNT(*) FROM shopProfileEntity WHERE id != :shopId) +
    (SELECT COUNT(*) FROM partyEntity WHERE shop_id != :shopId) +
    (SELECT COUNT(*) FROM commodityEntity WHERE shop_id != :shopId) +
    (SELECT COUNT(*) FROM dealEntity WHERE shop_id != :shopId) +
    (SELECT COUNT(*) FROM cashTransactionEntity WHERE shop_id != :shopId) +
    (SELECT COUNT(*) FROM entryRevisionEntity WHERE shop_id != :shopId)
) AS foreign_count;

-- Unsynced rows (sync_status = 0) belonging to another shop whose profile came from the server (sync_status = 1)
countForeignPendingFromServerShop:
SELECT (
    (SELECT COUNT(*) FROM partyEntity WHERE sync_status = 0 AND shop_id IN (SELECT id FROM shopProfileEntity WHERE id != :shopId AND sync_status = 1)) +
    (SELECT COUNT(*) FROM dealEntity WHERE sync_status = 0 AND shop_id IN (SELECT id FROM shopProfileEntity WHERE id != :shopId AND sync_status = 1)) +
    (SELECT COUNT(*) FROM cashTransactionEntity WHERE sync_status = 0 AND shop_id IN (SELECT id FROM shopProfileEntity WHERE id != :shopId AND sync_status = 1)) +
    (SELECT COUNT(*) FROM entryRevisionEntity WHERE sync_status = 0 AND shop_id IN (SELECT id FROM shopProfileEntity WHERE id != :shopId AND sync_status = 1))
) AS pending_count;

-- Local data wipe (sign-out / account switch), children first
wipeRevisions:
DELETE FROM entryRevisionEntity;

wipeCashTransactions:
DELETE FROM cashTransactionEntity;

wipeDeals:
DELETE FROM dealEntity;

wipeCommodities:
DELETE FROM commodityEntity;

wipeParties:
DELETE FROM partyEntity;

wipeShopProfiles:
DELETE FROM shopProfileEntity;

-- Sync Metadata (Cursor & State)
CREATE TABLE syncMetadataEntity (
    key TEXT PRIMARY KEY NOT NULL,
    value_text TEXT,
    value_long INTEGER NOT NULL DEFAULT 0
);

getSyncMetadataLong:
SELECT value_long FROM syncMetadataEntity WHERE key = ?;

setSyncMetadataLong:
INSERT OR REPLACE INTO syncMetadataEntity(key, value_long) VALUES (?, ?);

wipeSyncMetadata:
DELETE FROM syncMetadataEntity;


shopProfileExists:
SELECT COUNT(*) > 0 FROM shopProfileEntity WHERE id = ?;

-- ===== Buy / Sell / Lend / Expense (migration 3) =====
getBuyEntriesByShop:
SELECT * FROM buyEntryEntity WHERE shop_id = ? AND is_deleted = 0 ORDER BY entry_date DESC;

getBuyEntryById:
SELECT * FROM buyEntryEntity WHERE id = ?;

insertBuyEntry:
INSERT OR REPLACE INTO buyEntryEntity(
    id, shop_id, farmer_id, commodity_id, entry_date, bags_count, weight_per_bag_grams, extra_weight_grams,
    total_weight_grams, rate_paisa_per_quintal, commission_bps, labour_per_bag_paisa, advance_paid_paisa,
    gross_paisa, commission_paisa, labour_paisa, net_payable_paisa, paid_paisa, vehicle_number, slip_number, remarks,
    created_at, updated_at, is_deleted, sync_status, revision, is_void, void_reason
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getSellEntriesByShop:
SELECT * FROM sellEntryEntity WHERE shop_id = ? AND is_deleted = 0 ORDER BY entry_date DESC;

getSellEntryById:
SELECT * FROM sellEntryEntity WHERE id = ?;

insertSellEntry:
INSERT OR REPLACE INTO sellEntryEntity(
    id, shop_id, buyer_id, commodity_id, entry_date, bill_mode, party_kind, gstin, bags_count, weight_per_bag_grams,
    total_weight_grams, rate_paisa_per_quintal, arat_bps, tulak_paisa, gross_paisa, arat_paisa, mandi_shulk_paisa,
    total_receivable_paisa, received_paisa, balance_due_paisa, vehicle_number, invoice_number, remarks,
    created_at, updated_at, is_deleted, sync_status, revision, is_void, void_reason
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getLendEntriesByShop:
SELECT * FROM lendEntryEntity WHERE shop_id = ? AND is_deleted = 0 ORDER BY entry_date DESC;

getLendEntryById:
SELECT * FROM lendEntryEntity WHERE id = ?;

insertLendEntry:
INSERT OR REPLACE INTO lendEntryEntity(
    id, shop_id, party_id, lend_type, entry_date, amount_paisa, commodity_id, bags_count, weight_grams,
    expected_return_date, notes, status, created_at, updated_at, is_deleted, sync_status, revision, is_void, void_reason
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getLendSettlementsByLend:
SELECT * FROM lendSettlementEntity WHERE lend_id = ? AND is_void = 0 ORDER BY settled_at ASC;

insertLendSettlement:
INSERT OR REPLACE INTO lendSettlementEntity(
    id, shop_id, lend_id, settled_at, amount_paisa, weight_grams, bags_count,
    created_at, updated_at, sync_status, revision, is_void, void_reason
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getExpensesByShop:
SELECT * FROM expenseEntryEntity WHERE shop_id = ? AND is_deleted = 0 ORDER BY entry_date DESC;

getExpenseById:
SELECT * FROM expenseEntryEntity WHERE id = ?;

insertExpenseEntry:
INSERT OR REPLACE INTO expenseEntryEntity(
    id, shop_id, entry_date, category, amount_paisa, paid_to, payment_mode, remarks,
    created_at, updated_at, is_deleted, sync_status, revision, is_void, void_reason
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Godown stock: grams bought and sold per commodity (void and deleted rows excluded)
getStockBuyTotals:
SELECT commodity_id, COALESCE(SUM(total_weight_grams), 0) AS grams
FROM buyEntryEntity WHERE shop_id = ? AND is_deleted = 0 AND is_void = 0 GROUP BY commodity_id;

getStockSellTotals:
SELECT commodity_id, COALESCE(SUM(total_weight_grams), 0) AS grams
FROM sellEntryEntity WHERE shop_id = ? AND is_deleted = 0 AND is_void = 0 GROUP BY commodity_id;

-- Sync outbox
getPendingSyncBuyEntries:
SELECT * FROM buyEntryEntity WHERE sync_status = 0;
getPendingSyncSellEntries:
SELECT * FROM sellEntryEntity WHERE sync_status = 0;
getPendingSyncLendEntries:
SELECT * FROM lendEntryEntity WHERE sync_status = 0;
getPendingSyncLendSettlements:
SELECT * FROM lendSettlementEntity WHERE sync_status = 0;
getPendingSyncExpenses:
SELECT * FROM expenseEntryEntity WHERE sync_status = 0;

markBuyEntrySynced:
UPDATE buyEntryEntity SET sync_status = 1 WHERE id = ? AND revision = ?;
markSellEntrySynced:
UPDATE sellEntryEntity SET sync_status = 1 WHERE id = ? AND revision = ?;
markLendEntrySynced:
UPDATE lendEntryEntity SET sync_status = 1 WHERE id = ? AND revision = ?;
markLendSettlementSynced:
UPDATE lendSettlementEntity SET sync_status = 1 WHERE id = ? AND revision = ?;
markExpenseSynced:
UPDATE expenseEntryEntity SET sync_status = 1 WHERE id = ? AND revision = ?;

-- Sign-out wipe, children first
wipeLendSettlements:
DELETE FROM lendSettlementEntity;
wipeLendEntries:
DELETE FROM lendEntryEntity;
wipeBuyEntries:
DELETE FROM buyEntryEntity;
wipeSellEntries:
DELETE FROM sellEntryEntity;
wipeExpenses:
DELETE FROM expenseEntryEntity;
